library (computer) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }
  type ("A_out") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("B_out") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("flags_out") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }
  type ("last_opcode_out") {
    base_type : array;
    data_type : bit;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0;
  }

  cell ("computer") {
    pin("clk") {
      direction : input;
      capacitance : 0.0199;
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0036;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	fall_constraint(scalar) {
          values("0.07474");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	fall_constraint(scalar) {
          values("-0.02262");
	}
      }
    }
    bus("A_out") {
      bus_type : A_out;
      direction : output;
      capacitance : 0.0000;
    pin("A_out[7]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("A_out[6]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("A_out[5]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("A_out[4]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("A_out[3]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("A_out[2]") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("A_out[1]") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("A_out[0]") {
      direction : output;
      capacitance : 0.0011;
    }
    }
    bus("B_out") {
      bus_type : B_out;
      direction : output;
      capacitance : 0.0000;
    pin("B_out[7]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("B_out[6]") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("B_out[5]") {
      direction : output;
      capacitance : 0.0012;
    }
    pin("B_out[4]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("B_out[3]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("B_out[2]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("B_out[1]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("B_out[0]") {
      direction : output;
      capacitance : 0.0009;
    }
    }
    bus("flags_out") {
      bus_type : flags_out;
      direction : output;
      capacitance : 0.0000;
    pin("flags_out[3]") {
      direction : output;
      capacitance : 0.0010;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("0.97029,0.97353,0.98215,1.00442,1.07010,1.28420,1.99729");
	}
	rise_transition(template_1) {
          values("0.01570,0.01818,0.02599,0.05209,0.14411,0.45845,1.50121");
	}
	cell_fall(template_1) {
          values("1.07871,1.08175,1.08978,1.10845,1.15399,1.28932,1.73618");
	}
	fall_transition(template_1) {
          values("0.01540,0.01756,0.02339,0.03906,0.08871,0.26676,0.86779");
	}
      }
    }
    pin("flags_out[2]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("flags_out[1]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("flags_out[0]") {
      direction : output;
      capacitance : 0.0009;
    }
    }
    bus("last_opcode_out") {
      bus_type : last_opcode_out;
      direction : output;
      capacitance : 0.0000;
    pin("last_opcode_out[6]") {
      direction : output;
      capacitance : 0.0019;
    }
    pin("last_opcode_out[5]") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("last_opcode_out[4]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("last_opcode_out[3]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("last_opcode_out[2]") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("last_opcode_out[1]") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("last_opcode_out[0]") {
      direction : output;
      capacitance : 0.0010;
    }
    }
  }

}
