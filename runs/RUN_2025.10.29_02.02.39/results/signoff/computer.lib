library (computer) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 1.80;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00159,  0.00506,  0.01608,  0.05115,  0.16265,  0.51728");
  }
  type ("A_out") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("B_out") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("flags_out") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }
  type ("last_opcode_out") {
    base_type : array;
    data_type : bit;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0;
  }

  cell ("computer") {
    pin("clk") {
      direction : input;
      capacitance : 0.0019;
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0069;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	fall_constraint(scalar) {
          values("0.07031");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	fall_constraint(scalar) {
          values("0.01643");
	}
      }
    }
    pin("VPWR") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VGND") {
      direction : input;
      capacitance : 0.0000;
    }
    bus("A_out") {
      bus_type : A_out;
      direction : output;
      capacitance : 0.0000;
    pin("A_out[7]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("A_out[6]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("A_out[5]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("A_out[4]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("A_out[3]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("A_out[2]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("A_out[1]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("A_out[0]") {
      direction : output;
      capacitance : 0.0000;
    }
    }
    bus("B_out") {
      bus_type : B_out;
      direction : output;
      capacitance : 0.0000;
    pin("B_out[7]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("B_out[6]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("B_out[5]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("B_out[4]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("B_out[3]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("B_out[2]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("B_out[1]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("B_out[0]") {
      direction : output;
      capacitance : 0.0000;
    }
    }
    bus("flags_out") {
      bus_type : flags_out;
      direction : output;
      capacitance : 0.0000;
    pin("flags_out[3]") {
      direction : output;
      capacitance : 0.0000;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("0.50235,0.50671,0.51798,0.54544,0.61851,0.84283,1.55327");
	}
	rise_transition(template_1) {
          values("0.02225,0.02551,0.03528,0.06457,0.16178,0.48312,1.50732");
	}
	cell_fall(template_1) {
          values("0.53283,0.53674,0.54684,0.57000,0.62419,0.77638,1.25606");
	}
	fall_transition(template_1) {
          values("0.02066,0.02329,0.03049,0.04997,0.10914,0.30680,0.95080");
	}
      }
    }
    pin("flags_out[2]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("flags_out[1]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("flags_out[0]") {
      direction : output;
      capacitance : 0.0000;
    }
    }
    bus("last_opcode_out") {
      bus_type : last_opcode_out;
      direction : output;
      capacitance : 0.0000;
    pin("last_opcode_out[6]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("last_opcode_out[5]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("last_opcode_out[4]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("last_opcode_out[3]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("last_opcode_out[2]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("last_opcode_out[1]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("last_opcode_out[0]") {
      direction : output;
      capacitance : 0.0000;
    }
    }
  }

}
