library (computer) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00159,  0.00506,  0.01608,  0.05115,  0.16265,  0.51728");
  }
  type ("A_out") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("B_out") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("flags_out") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }
  type ("last_opcode_out") {
    base_type : array;
    data_type : bit;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0;
  }

  cell ("computer") {
    pin("clk") {
      direction : input;
      capacitance : 0.0198;
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0035;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	fall_constraint(scalar) {
          values("0.13396");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	fall_constraint(scalar) {
          values("-0.04826");
	}
      }
    }
    bus("A_out") {
      bus_type : A_out;
      direction : output;
      capacitance : 0.0000;
    pin("A_out[7]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("A_out[6]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("A_out[5]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("A_out[4]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("A_out[3]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("A_out[2]") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("A_out[1]") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("A_out[0]") {
      direction : output;
      capacitance : 0.0011;
    }
    }
    bus("B_out") {
      bus_type : B_out;
      direction : output;
      capacitance : 0.0000;
    pin("B_out[7]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("B_out[6]") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("B_out[5]") {
      direction : output;
      capacitance : 0.0012;
    }
    pin("B_out[4]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("B_out[3]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("B_out[2]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("B_out[1]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("B_out[0]") {
      direction : output;
      capacitance : 0.0009;
    }
    }
    bus("flags_out") {
      bus_type : flags_out;
      direction : output;
      capacitance : 0.0000;
    pin("flags_out[3]") {
      direction : output;
      capacitance : 0.0010;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("0.96965,0.97401,0.98529,1.01275,1.08581,1.31012,2.02059");
	}
	rise_transition(template_1) {
          values("0.02223,0.02551,0.03526,0.06458,0.16175,0.48311,1.50729");
	}
	cell_fall(template_1) {
          values("1.07820,1.08211,1.09222,1.11538,1.16957,1.32174,1.80133");
	}
	fall_transition(template_1) {
          values("0.02064,0.02328,0.03049,0.04999,0.10916,0.30682,0.95142");
	}
      }
    }
    pin("flags_out[2]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("flags_out[1]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("flags_out[0]") {
      direction : output;
      capacitance : 0.0009;
    }
    }
    bus("last_opcode_out") {
      bus_type : last_opcode_out;
      direction : output;
      capacitance : 0.0000;
    pin("last_opcode_out[6]") {
      direction : output;
      capacitance : 0.0019;
    }
    pin("last_opcode_out[5]") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("last_opcode_out[4]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("last_opcode_out[3]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("last_opcode_out[2]") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("last_opcode_out[1]") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("last_opcode_out[0]") {
      direction : output;
      capacitance : 0.0010;
    }
    }
  }

}
